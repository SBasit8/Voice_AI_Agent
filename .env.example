# --- Database ---
# Local dev default (SQLite file, good enough for quick iteration):
DATABASE_URL=sqlite:///./patients.db
# Production (Render Postgres, persists across restarts/redeploys):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Vapi ---
# Found in the Vapi dashboard under Settings > API Keys. Only needed to run
# scripts/create_assistant.py (provisioning). The running FastAPI app never
# calls Vapi itself, so this is NOT required just to serve the API.
VAPI_API_KEY=

# Shared secret Vapi sends back on every tool-call/webhook request as the
# `x-vapi-secret` header. Set the same value in the Vapi assistant's server
# config. Optional locally, strongly recommended in production so random
# internet traffic can't POST fake "create_patient" calls to your webhook.
VAPI_WEBHOOK_SECRET=

# Public base URL this FastAPI app is reachable at (used by
# scripts/create_assistant.py to wire up the assistant's serverUrl).
# e.g. https://your-app.onrender.com or an ngrok https URL during local dev.
PUBLIC_BASE_URL=http://localhost:8000

# --- App ---
LOG_LEVEL=INFO
PORT=8000
